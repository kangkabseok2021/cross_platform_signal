.PHONY : third_party/sqlite3.i

# target to preprocess a source file
third_party/sqlite3.c.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/sqlite3_bundled.dir/build.make CMakeFiles/sqlite3_bundled.dir/third_party/sqlite3.c.i
.PHONY : third_party/sqlite3.c.i

third_party/sqlite3.s: third_party/sqlite3.c.s
.PHONY : third_party/sqlite3.s

# target to generate assembly for a file
third_party/sqlite3.c.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/sqlite3_bundled.dir/build.make CMakeFiles/sqlite3_bundled.dir/third_party/sqlite3.c.s
.PHONY : third_party/sqlite3.c.s

