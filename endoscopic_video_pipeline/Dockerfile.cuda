# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM nvcr.io/nvidia/cuda:12.3.2-devel-ubuntu22.04 AS builder
WORKDIR /build

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    cmake ninja-build pkg-config \
    libgstreamer1.0-dev gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good gstreamer1.0-plugins-ugly \
    libgstreamer-app1.0-dev libgstreamer-video1.0-dev \
    gstreamer1.0-libav \
    && rm -rf /var/lib/apt/lists/*

COPY . .

RUN cmake -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DENABLE_CUDA=ON \
      -DCMAKE_CUDA_ARCHITECTURES="75;86;89" && \
    cmake --build build --target endoscopic_pipeline

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM nvcr.io/nvidia/cuda:12.3.2-runtime-ubuntu22.04

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav libgstreamer-app1.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /build/build/endoscopic_pipeline .

ENTRYPOINT ["./endoscopic_pipeline"]
CMD ["--help"]
