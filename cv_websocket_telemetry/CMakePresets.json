{
    "version": 3,
    "configurePresets": [
        {
            "name": "linux",
            "displayName": "Linux Release (Ninja + Conan toolchain)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/conan_toolchain.cmake",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/conan_toolchain.cmake",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "docker",
            "displayName": "Docker Release (Ninja + Conan toolchain)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/docker",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/conan_toolchain.cmake"
            }
        }
    ],
    "buildPresets": [
        { "name": "linux",       "configurePreset": "linux" },
        { "name": "linux-debug", "configurePreset": "linux-debug" },
        { "name": "docker",      "configurePreset": "docker" }
    ]
}
